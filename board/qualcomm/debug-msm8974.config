# Most MSM8974 phones have no reachable UART: keep the console in a RAM
# buffer that the previous bootloader (e.g. lk2nd "fastboot oem debug readl")
# can read back after a warm reset.
CONFIG_DEBUG_UART=y
CONFIG_DEBUG_UART_ANNOUNCE=y
CONFIG_DEBUG_UART_RAMLOG=y
CONFIG_DEBUG_UART_BASE=0x68000000
CONFIG_DEBUG_UART_CLOCK=0
